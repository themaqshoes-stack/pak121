{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python -m pip install --upgrade 'pip>=24.1' 'setuptools>=70' 'wheel>=0.43' && python -m pip install --no-cache-dir -r requirements.txt",
    "start": "python -m uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30",
    "nixpacksPlanVersion": 1,
    "nixpacksPlan": {
      "providers": ["python", "node"],
      "variables": {
        "PYTHON_VERSION": "3.12",
        "NODE_VERSION": "20",
        "NIXPACKS_START_CMD": "python -m uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30",
        "NIXPACKS_BUILD_CMD": "python -m pip install --upgrade 'pip>=24.1' 'setuptools>=70' 'wheel>=0.43' && python -m pip install --no-cache-dir -r requirements.txt"
      },
      "phases": {
        "setup": {
          "aptPkgs": [
            "libgomp1",
            "libgl1",
            "libglib2.0-0",
            "libsm6",
            "libxext6",
            "libxrender-dev",
            "nodejs",
            "npm"
          ]
        },
        "install": {
          "cmds": [
            "python -m pip install --upgrade 'pip>=24.1' 'setuptools>=70' 'wheel>=0.43'",
            "python -m pip install --no-cache-dir -r requirements.txt"
          ]
        },
        "build": {
          "dependsOn": ["setup", "install"],
          "cmds": [
            "node --version 2>/dev/null || true",
            "npm --version 2>/dev/null || true",
            "python --version"
          ]
        },
        "start": {
          "dependsOn": ["build"],
          "cmd": "python -m uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30"
        }
      }
    },
    "watchPatterns": [
      "cad_backend.py",
      "requirements.txt",
      "pyproject.toml",
      "Procfile",
      "railway.json",
      "package.json"
    ]
  },
  "deploy": {
    "start": "python -m uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30",
    "startCommand": "python -m uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30",
    "healthcheck": {
      "type": "http",
      "path": "/health",
      "intervalSeconds": 60,
      "timeoutSeconds": 20,
      "healthyThreshold": 2,
      "unhealthyThreshold": 5
    },
    "restartPolicy": {
      "type": "on_failure",
      "maxRetries": 5
    },
    "startupProbe": {
      "type": "http",
      "path": "/health",
      "initialDelaySeconds": 15,
      "periodSeconds": 10,
      "successThreshold": 1,
      "failureThreshold": 60,
      "timeoutSeconds": 15
    }
  }
}
