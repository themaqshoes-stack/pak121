{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlanVersion": 1,
    "nixpacksPlan": {
      "providers": ["python"],
      "excludeProviders": ["node", "bun", "deno"],
      "variables": {
        "PYTHON_VERSION": "3.12"
      },
      "phases": {
        "setup": {
          "aptPkgs": ["libgomp1", "libgl1", "libglib2.0-0", "libsm6", "libxext6", "libxrender-dev"]
        },
        "install": {
          "cmds": [
            "rm -f package.json package-lock.json yarn.lock pnpm-lock.yaml pnpm-workspace.yaml bun.lockb deno.lock",
            "python -m pip install --upgrade 'pip>=24.1' 'setuptools>=70' 'wheel>=0.43'",
            "python -m pip install --no-cache-dir -r requirements.txt"
          ]
        },
        "build": {
          "dependsOn": ["setup", "install"]
        }
      }
    },
    "watchPatterns": [
      "cad_backend.py",
      "requirements.txt",
      "pyproject.toml",
      "Procfile",
      "railway.json"
    ]
  },
  "deploy": {
    "start": "uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300 --timeout-graceful-shutdown 30",
    "healthcheck": {
      "type": "http",
      "path": "/health",
      "intervalSeconds": 60,
      "timeoutSeconds": 20,
      "healthyThreshold": 2,
      "unhealthyThreshold": 5
    },
    "restartPolicy": {
      "type": "on_failure",
      "maxRetries": 5
    },
    "startupProbe": {
      "type": "http",
      "path": "/health",
      "initialDelaySeconds": 15,
      "periodSeconds": 10,
      "successThreshold": 1,
      "failureThreshold": 60,
      "timeoutSeconds": 15
    }
  }
}
