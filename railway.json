{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksBuildCommand": "pip install -r requirements.txt",
    "nixpacksPlan": {
      "providers": ["python"]
    }
  },
  "deploy": {
    "start": "uvicorn cad_backend:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=\"*\" --timeout-keep-alive 300",
    "healthcheck": {
      "type": "http",
      "path": "/health",
      "intervalSeconds": 60,
      "timeoutSeconds": 15,
      "healthyThreshold": 2,
      "unhealthyThreshold": 5
    },
    "restartPolicy": {
      "type": "on_failure",
      "maxRetries": 5
    },
    "startupProbe": {
      "type": "http",
      "path": "/health",
      "initialDelaySeconds": 10,
      "periodSeconds": 10,
      "successThreshold": 1,
      "failureThreshold": 30,
      "timeoutSeconds": 10
    }
  }
}
